# Copy to .env.local — never commit real secrets.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Required for super-admin pages that list merchants / review applications (bypasses RLS).
# Same value as Supabase Dashboard → Settings → API → service_role (server only).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Proxy for merchant application notifications → @chopfast/api (server-side only)
CHOPFAST_API_URL=http://localhost:4000
CHOPFAST_INTERNAL_API_KEY=change-me-same-as-packages-api-INTERNAL_API_KEY

# Merchant portal API (defaults to localhost:4000 if unset)
NEXT_PUBLIC_CHOPFAST_API_URL=http://localhost:4000
