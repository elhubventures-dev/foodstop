# --- API ---
PORT=4000
NODE_ENV=development
INTERNAL_API_KEY=change-me-internal-shared-secret

# --- Supabase (server-side: SERVICE ROLE, never expose to client) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Redis / BullMQ (release-pending-balance jobs) ---
REDIS_URL=redis://localhost:6379

# --- Commission engine ---
DEFAULT_COMMISSION_RATE=0.15
VAT_RATE=0.075
PENDING_HOLD_HOURS=2
DISPUTE_HOLD_HOURS=24

# --- CORS (browser calls to @chopfast/api, comma-separated origins) ---
# CORS_ORIGINS=http://localhost:3000,https://foodstop.com.ng

# --- Merchant registration (Resend email OTP + Paystack Resolve + Cloudinary URLs) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=Food Stop
# Withdrawal OTP SMS + post-approval SMS still use Termii when set:
TERMII_API_KEY=
TERMII_BASE_URL=https://api.ng.termii.com
TERMII_SENDER_ID=Foodstop
PAYSTACK_SECRET_KEY=
CLOUDINARY_CLOUD_NAME=

# --- Merchant JWT (sign tokens on login — separate from customer auth) ---
MERCHANT_JWT_SECRET=
# Access token TTL in seconds (default 86400 = 24h)
MERCHANT_JWT_EXPIRES_SEC=86400

# --- Post-approval / RFI / rejection emails (SendGrid) + SMS (Termii uses keys above) ---
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=Food Stop
# Customer site origin (no trailing slash) — used in merchant approval emails/SMS
CUSTOMER_WEB_BASE_URL=https://foodstop.com.ng
# Optional dedicated merchant portal URL for login links
MERCHANT_PORTAL_BASE_URL=
PLATFORM_NAME=Food Stop
PLATFORM_SUPPORT_EMAIL=
# Optional: https URL to your logo for branded HTML emails (merchant OTP, etc.)
PLATFORM_EMAIL_LOGO_URL=

# --- Withdrawals / Paystack Transfer ---
# Minimum withdrawal (NGN)
WITHDRAWAL_MIN_NGN=1000
# Amounts ≥ this need admin_approved before Paystack initiate (set via SQL or admin API)
WITHDRAWAL_ADMIN_THRESHOLD_NGN=500000
MERCHANT_WITHDRAWAL_OTP_BYPASS=
